# Keep the baked source tree clean + small (COPY . /hanoi-python). Exclude caches,
# build artifacts, exported image tars, and the vendored emacs elpa/eln trees (the
# image installs emacs packages itself; the elpa tree is for the runtime bind-mount).
# Patterns are anchored at the context root (unlike .gitignore), so anything that
# can appear below the root needs a leading **/.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.ruff_cache/
*.tar
entrypoint/dotfiles/.emacs.d/elpa/
entrypoint/dotfiles/.emacs.d/eln-cache/
