{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Towers of Hanoi",
  "version": "0.1.0",
  "identifier": "com.billsix.hanoi",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Towers of Hanoi (Tauri)",
        "width": 920,
        "height": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
