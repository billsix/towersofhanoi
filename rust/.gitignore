# Cargo build output (compiled artifacts are never committed).
/target
# The container's Cargo caches on the bind-mount, set by shell.sh and the run targets
# (`cd rust && make cli | tui | wx | tauri`): CARGO_TARGET_DIR caches wxDragon's
# from-source wxWidgets build, CARGO_HOME the crate-registry downloads. Shared by the
# workspace and the Tauri crate (whose own build dir is rust/tauri/, ignored there).
/.container-target
/.container-cargo

# emacs / lsp-mode runtime junk written into the mounted tree during a session
.lsp-session-v1
*~
\#*\#
.\#*
entrypoint/dotfiles/.emacs.d/eln-cache/
entrypoint/dotfiles/.emacs.d/elpa/*.elc
entrypoint/dotfiles/.emacs.d/elpa/**/*.elc
entrypoint/dotfiles/.emacs.d/elpa/**/*.eln
